TEXT 160 48 Left 4 ;Rock-paper-scissors referee (LTspice built-in logic gates, logic 1 = 1 V)
TEXT 160 128 Left 3 ;DECISION LOGIC   (00 = none/invalid, 01 = Rock, 10 = Paper, 11 = Scissors;  A = player 1, B = player 2)
TEXT 1952 128 Left 3 ;ENABLE EDGE DETECTOR   (one count pulse per ENABLE press)
TEXT 1952 608 Left 3 ;PLAYER 1 SCORE COUNTER   (3-bit, synchronous reset; score bits P1S2 P1S1 P1S0)
TEXT 1952 1456 Left 3 ;PLAYER 2 SCORE COUNTER   (3-bit, synchronous reset; score bits P2S2 P2S1 P2S0)
TEXT 160 2464 Left 3 ;TEST STIMULUS   (reset, 8 rounds, reset)
TEXT 160 2528 Left 2 !.tran 10000n
TEXT 160 2560 Left 2 !VCLK CLK 0 PULSE(0 1 50n 1n 1n 49n 100n)
TEXT 160 2592 Left 2 !VRST RST 0 PWL(0 1 320n 1 321n 0 8800n 0 8801n 1 9300n 1 9301n 0)
TEXT 160 2624 Left 2 !VA1 A1 0 PWL(0 0 1500n 0 1501n 1 2500n 1 2501n 0 4500n 0 4501n 1 6500n 1 6501n 0 7500n 0 7501n 1)
TEXT 160 2656 Left 2 !VA0 A0 0 PWL(0 0 500n 0 501n 1 1500n 1 1501n 0 2500n 0 2501n 1 3500n 1 3501n 0 4500n 0 4501n 1 5500n 1 5501n 0 6500n 0 6501n 1)
TEXT 160 2688 Left 2 !VB1 B1 0 PWL(0 0 500n 0 501n 1 2500n 1 2501n 0 3500n 0 3501n 1 5500n 1 5501n 0 6500n 0 6501n 1 7500n 1 7501n 0)
TEXT 160 2720 Left 2 !VB0 B0 0 PWL(0 0 500n 0 501n 1 3500n 1 3501n 0 5500n 0 5501n 1)
